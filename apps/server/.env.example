# 应用模式: local | cloud
APP_MODE=local

# 服务端口
PORT=18765

# 数据库配置
# 本地SQLite: file:./data/novel.db
# 云端PostgreSQL: postgresql://user:password@localhost:5432/ai_novel_studio
DATABASE_URL=file:./data/novel.db

# 存储配置: local | s3 | cos | oss | minio
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads

# 队列配置: sqlite | redis
QUEUE_DRIVER=sqlite
REDIS_URL=

# 认证配置
AUTH_MODE=local
# 必须替换为强随机值：node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-strong-random-secret
JWT_EXPIRES_IN=7d
# 用于API Key等本地敏感配置加密，建议与JWT_SECRET不同
APP_SECRET=replace-with-strong-random-app-secret

# 知识库配置
# 开发环境可用绝对路径；安装版建议由启动器动态写入
KNOWLEDGE_PATH=./knowledge
KNOWLEDGE_RETRIEVAL_MODE=fts
OLLAMA_BASE_URL=http://127.0.0.1:11434

# AI模型配置（可选）
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
DEFAULT_MODEL=ollama

# Web安全/日志
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:18765
